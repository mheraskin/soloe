{
  "name": "soloe",
  "version": "0.1.0",
  "description": "Local-first agent development environment for solo developers using CLI agents",
  "license": "MIT",
  "author": "Mykhail Heraskin",
  "desktopName": "com.soloe.app.desktop",
  "homepage": "https://github.com/mheraskin/soloe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mheraskin/soloe.git"
  },
  "bugs": {
    "url": "https://github.com/mheraskin/soloe/issues"
  },
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild",
      "node-pty"
    ]
  },
  "main": "out/main/main.js",
  "scripts": {
    "dev": "pnpm dev:tray",
    "dev:runtime": "pnpm --filter @soloe/runtime dev",
    "dev:server": "pnpm --filter @soloe/server dev",
    "dev:web": "pnpm --filter @soloe/web dev",
    "dev:desktop": "pnpm --filter @soloe/desktop-electron dev",
    "dev:tray": "pnpm --filter @soloe/tray dev",
    "configure:backend": "node scripts/configure-backend.mjs",
    "dev:tauri-ui": "vite --config vite.tauri.config.ts",
    "dev:tauri": "tauri dev",
    "build": "electron-vite build",
    "build:tauri-ui": "vite build --config vite.tauri.config.ts",
    "build:tauri": "tauri build --no-bundle",
    "build:rust": "cargo build --release -p soloe-terminal",
    "check:renderer-budget": "node scripts/check-renderer-entry-budget.mjs",
    "benchmark:electron": "pnpm build && node scripts/benchmark-electron.mjs",
    "benchmark:rust": "pnpm build:rust && pnpm build && node scripts/benchmark-electron.mjs --terminal-backend=rust",
    "benchmark:tauri": "pnpm build:tauri && node scripts/benchmark-tauri.mjs",
    "build:icon:pwa": "node scripts/generate-pwa-icons.mjs",
    "build:icon:win": "node scripts/generate-windows-icon.mjs",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:svelte": "svelte-check --tsconfig tsconfig.web.json",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web && pnpm typecheck:svelte",
    "package": "electron-vite build && electron-builder --publish never",
    "package:windows": "electron-vite build && electron-builder --win --x64 --publish never",
    "package:linux": "electron-vite build && electron-builder --linux AppImage deb --x64 --publish never",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "electron-builder install-app-deps",
    "test": "vitest run",
    "test:browser-integration": "pnpm --filter @soloe/web build && pnpm --filter @soloe/desktop-electron build && node scripts/browser-integration.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@fontsource/cascadia-code": "^5.2.3",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@lezer/highlight": "^1.2.3",
    "@pierre/trees": "^1.0.0-beta.3",
    "@soloe/domain": "workspace:*",
    "@soloe/protocol": "workspace:*",
    "@soloe/runtime": "workspace:*",
    "@tauri-apps/api": "^2.11.1",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "codemirror": "^6.0.2",
    "element-source": "^0.0.5",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.3",
    "node-pty": "^1.0.0",
    "smol-toml": "^1.6.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@fontsource-variable/inter": "^5.2.8",
    "@internationalized/date": "^3.12.1",
    "@lucide/svelte": "^1.14.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.2.4",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.1",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "mode-watcher": "^1.1.0",
    "shadcn-svelte": "^1.2.7",
    "svelte": "^5.0.0",
    "svelte-check": "^4.4.8",
    "svelte-sonner": "^1.1.1",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.2",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22"
  }
}
