{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soloe Tauri Spike",
  "version": "0.1.0",
  "identifier": "com.soloe.tauri-spike",
  "build": {
    "beforeDevCommand": "npm run dev:tauri-ui",
    "beforeBuildCommand": "npm run build:tauri-ui",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../out/tauri-renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "tauri.html",
        "title": "Soloe — Tauri terminal spike",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": false
  }
}
