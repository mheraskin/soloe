diff --git a/src/termio/ExecManualOnly.zig b/src/termio/ExecManualOnly.zig
new file mode 100644
index 000000000..174143092
--- /dev/null
+++ b/src/termio/ExecManualOnly.zig
@@ -0,0 +1,88 @@
+//! Compile-time placeholder for Windows embedded builds that use manual I/O.
+//!
+//! The full Exec backend owns a subprocess and PTY. Soloe's Environment
+//! Runtime owns both, so its Windows Ghostty library must never instantiate
+//! that backend. Keeping this placeholder behind the existing Backend union
+//! preserves shared type shapes without importing POSIX-only Exec code.
+const Exec = @This();
+
+const std = @import("std");
+const configpkg = @import("../config.zig");
+const Command = @import("../Command.zig");
+const ProcessInfo = @import("../pty.zig").ProcessInfo;
+const renderer = @import("../renderer.zig");
+const terminal = @import("../terminal/main.zig");
+const termio = @import("../termio.zig");
+
+subprocess: struct {
+    args: []const [:0]const u8 = &.{},
+} = .{},
+
+pub const Config = struct {
+    command: ?configpkg.Command = null,
+    env: std.process.Environ.Map,
+    env_override: configpkg.RepeatableStringMap = .{},
+    shell_integration: configpkg.Config.ShellIntegration = .detect,
+    shell_integration_features: configpkg.Config.ShellIntegrationFeatures = .{},
+    cursor_blink: ?bool = null,
+    working_directory: ?[]const u8 = null,
+    resources_dir: ?[]const u8,
+    term: []const u8,
+    rt_pre_exec_info: Command.RtPreExecInfo,
+    rt_post_fork_info: Command.RtPostForkInfo,
+};
+
+pub fn init(_: std.mem.Allocator, _: Config) !Exec {
+    return error.ExecBackendUnavailable;
+}
+
+pub fn deinit(_: *Exec) void {}
+
+pub fn initTerminal(_: *Exec, _: *terminal.Terminal) void {}
+
+pub fn threadEnter(
+    _: *Exec,
+    _: std.mem.Allocator,
+    _: *termio.Termio,
+    _: *termio.Termio.ThreadData,
+) !void {
+    return error.ExecBackendUnavailable;
+}
+
+pub fn threadExit(_: *Exec, _: *termio.Termio.ThreadData) void {}
+
+pub fn focusGained(_: *Exec, _: *termio.Termio.ThreadData, _: bool) !void {
+    return error.ExecBackendUnavailable;
+}
+
+pub fn resize(_: *Exec, _: renderer.GridSize, _: renderer.ScreenSize) !void {
+    return error.ExecBackendUnavailable;
+}
+
+pub fn queueWrite(
+    _: *Exec,
+    _: std.mem.Allocator,
+    _: *termio.Termio.ThreadData,
+    _: []const u8,
+    _: bool,
+) !void {
+    return error.ExecBackendUnavailable;
+}
+
+pub fn childExitedAbnormally(
+    _: *Exec,
+    _: std.mem.Allocator,
+    _: *terminal.Terminal,
+    _: u32,
+    _: u64,
+) !void {
+    return error.ExecBackendUnavailable;
+}
+
+pub fn getProcessInfo(_: *Exec, comptime info: ProcessInfo) ?ProcessInfo.Type(info) {
+    return null;
+}
+
+pub const ThreadData = struct {
+    pub fn deinit(_: *ThreadData, _: std.mem.Allocator) void {}
+};
